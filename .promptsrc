## Schema do Banco de Dados (Prisma)
```prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// 1. DADOS DA EMPRESA (Emitente Fiscal)
model Company {
  id                Int      @id @default(autoincrement())
  corporateName     String   // Razão Social
  tradeName         String?  // Nome Fantasia
  cnpj              String   @unique
  stateRegistration String?  // Inscrição Estadual (IE)
  phone             String?
  email             String?
  addressLine       String?  // Logradouro, Número, Bairro
  city              String?
  state             String?
  zipCode           String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt
}

// 2. FORNECEDORES
model Supplier {
  id                Int             @id @default(autoincrement())
  corporateName     String          // Razão Social
  tradeName         String?         // Nome Fantasia
  cnpj              String          @unique
  stateRegistration String?         // IE
  contactName       String?         // Nome do representante/vendedor
  phone             String?
  email             String?
  address           String?
  products          Product[]
  stockMovements    StockMovement[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @default(now()) @updatedAt
}

// 3. OPERADORES / USUÁRIOS
model User {
  id             Int             @id @default(autoincrement())
  name           String
  email          String          @unique
  password       String?         // Senha de login
  pin            String?         // PIN de 4 a 6 dígitos (Abertura/Liberacao de Caixa)
  role           String          @default("CASHIER") // ADMIN, MANAGER, CASHIER
  active         Boolean         @default(true)
  sales          Sale[]
  openedRegisters CashRegister[] @relation("OpenedBy")
  closedRegisters CashRegister[] @relation("ClosedBy")
  stockMovements StockMovement[]
  auditLogs      AuditLog[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @default(now()) @updatedAt
}

// 4. CLIENTES
model Customer {
  id        Int      @id @default(autoincrement())
  name      String
  document  String?  @unique // CPF ou CNPJ
  email     String?
  phone     String?
  address   String?
  sales     Sale[]
  createdAt DateTime @default(now())
}

// 5. CATEGORIAS DE PRODUTOS
model Category {
  id       Int       @id @default(autoincrement())
  name     String
  products Product[]
}

// 6. PRODUTOS, TRIBUTAÇÃO E FORNECEDOR
model Product {
  id            Int             @id @default(autoincrement())
  name          String
  barcode       String?         @unique // Código de barras EAN/GTIN
  price         Float           // Preço de Venda
  costPrice     Float?          @default(0.0) // Preço de Custo
  stock         Int             @default(0)
  minStock      Int             @default(5)   // Alerta de estoque baixo
  unit          String          @default("UN")// UN, KG, LT, CX
  
  // Requisitos Fiscais
  ncm           String?         // Nomenclatura Comum do Mercosul
  cest          String?         // Código Especificador da Substituição Tributária
  taxPercentage Float           @default(0.0) // Alíquota IBPT
  
  // Relacionamentos
  categoryId    Int?
  category      Category?       @relation(fields: [categoryId], references: [id])
  supplierId    Int?
  supplier      Supplier?       @relation(fields: [supplierId], references: [id])
  
  saleItems     SaleItem[]
  stockMovements StockMovement[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @default(now()) @updatedAt
}

// 7. CONTROLE DE ESTOQUE (HISTÓRICO)
model StockMovement {
  id            Int      @id @default(autoincrement())
  productId     Int
  product       Product  @relation(fields: [productId], references: [id])
  supplierId    Int?
  supplier      Supplier? @relation(fields: [supplierId], references: [id])
  userId        Int?
  user          User?    @relation(fields: [userId], references: [id])
  
  type          String   // IN_PURCHASE, OUT_SALE, IN_ADJUSTMENT, OUT_LOSS, OUT_ADJUSTMENT
  quantity      Int
  unitCost      Float?
  invoiceNumber String?
  notes         String?
  
  createdAt     DateTime @default(now())
}

// 8. CONTROLE DE CAIXA (TURNOS / SANGRIAS)
model CashRegister {
  id               Int               @id @default(autoincrement())
  userId           Int               // Quem abriu o caixa
  user             User              @relation("OpenedBy", fields: [userId], references: [id])
  closedById       Int?              // Quem fechou o caixa
  closedBy         User?             @relation("ClosedBy", fields: [closedById], references: [id])
  
  openedAt         DateTime          @default(now())
  closedAt         DateTime?
  initialBalance   Float             // Fundo de Troco Inicial
  calculatedBalance Float?           // Saldo Esperado pelo Sistema no Fechamento
  finalBalance     Float?            // Saldo Informado na Conferência Cega
  status           String            @default("OPEN") // OPEN, CLOSED
  openingNotes     String?
  closingNotes     String?
  
  transactions     CashTransaction[]
  sales            Sale[]
}

// 9. MOVIMENTAÇÕES DE CAIXA (Sangria / Suprimento)
model CashTransaction {
  id             Int          @id @default(autoincrement())
  cashRegisterId Int
  cashRegister   CashRegister @relation(fields: [cashRegisterId], references: [id])
  type           String       // CASH_IN (Suprimento), CASH_OUT (Sangria)
  amount         Float
  reason         String?
  createdAt      DateTime     @default(now())
}

// 10. VENDAS COMPLETAS
model Sale {
  id               Int           @id @default(autoincrement())
  code             String?       @unique // Código Único
  subtotal         Float         @default(0.0)
  discount         Float         @default(0.0)
  total            Float
  paidAmount       Float         @default(0.0)
  changeAmount     Float         @default(0.0)
  status           String        @default("COMPLETED") // COMPLETED, CANCELED
  
  // Dados do Cliente
  customerId       Int?
  customer         Customer?     @relation(fields: [customerId], references: [id])
  customerName     String?
  customerDocument String?
  
  // Operador e Caixa
  userId           Int?
  user             User?         @relation(fields: [userId], references: [id])
  cashRegisterId   Int?
  cashRegister     CashRegister? @relation(fields: [cashRegisterId], references: [id])
  
  // Detalhes Fiscais
  taxTotal         Float         @default(0.0)
  fiscalKey        String?
  
  items            SaleItem[]
  payments         SalePayment[] // Múltiplas formas de pagamento por venda
  createdAt        DateTime      @default(now())
  canceledAt       DateTime?
}

// 11. MÚLTIPLAS FORMAS DE PAGAMENTO
model SalePayment {
  id            Int      @id @default(autoincrement())
  saleId        Int
  sale          Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  method        String   // MONEY, PIX, CREDIT_CARD, DEBIT_CARD
  amount        Float    // Valor pago nessa modalidade
  createdAt     DateTime @default(now())
}

// 12. ITENS DA VENDA
model SaleItem {
  id         Int     @id @default(autoincrement())
  saleId     Int
  sale       Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId  Int
  product    Product @relation(fields: [productId], references: [id])
  quantity   Int
  price      Float   // Preço de venda praticado
  costPrice  Float?  @default(0.0) // Custo histórico no momento da venda
  discount   Float   @default(0.0)
  subtotal   Float   @default(0.0) // (quantity * price) - discount
  taxAmount  Float   @default(0.0)
}

// 13. TRILHA DE AUDITORIA
model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id])
  action    String   // CANCELED_SALE, PRICE_OVERRIDE, CASH_DRAWER_OPEN, STOCK_ADJUSTMENT
  details   String
  createdAt DateTime @default(now())
}```

## Diretrizes para a Frente de Caixa (PDV)
1. **Carrinho e Vendas:** Utilizar busca rápida por input e gerenciar o estado dos itens no componente da página de checkout.
2. **Operações de Banco:** Garantir que a criação de pedidos e a baixa de estoque ocorram via `prisma.$transaction`.
3. **Padrão Visual:** Manter a consistência com Tailwind CSS e ícones do `lucide-react`.
